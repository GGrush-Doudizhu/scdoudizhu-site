---
import WeeklyPattern from "../components/WeeklyPattern.astro";
import { season } from "../data/season";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <section class="home-hero">
    <div class="home-hero-art" aria-hidden="true"></div>
    <div class="container home-hero-grid">
      <div class="home-hero-copy">
        <p class="hero-kicker">第二届 · 2026年8月24日开赛</p>
        <h1><span>第二届</span>斗地主星际联赛</h1>
        <p class="lede">
          面向星际玩家的斗地主社区联赛。常规赛累计个人积分，无需提前报名；比赛时段进入房间即可参加。
        </p>
        <div class="hero-actions">
          <a class="button button--primary" href="/standings/">常规赛积分榜</a>
          <a class="button button--secondary" href="/rules/">了解比赛规则</a>
        </div>
      </div>

      <div class="card-fleet" aria-label="斗地主扑克牌与星际舰队主题图形">
        <div class="playing-card playing-card--ace" aria-hidden="true">
          <span>A</span><strong>♥</strong><small>第二届</small>
        </div>
        <div class="playing-card playing-card--king" aria-hidden="true">
          <span>K</span><strong>♠</strong><small>斗地主</small>
        </div>
        <div class="playing-card playing-card--queen" aria-hidden="true">
          <span>Q</span><strong>♦</strong><small>星际联赛</small>
        </div>
      </div>
    </div>
  </section>

  <div class="container status-strip" aria-label="赛事概览">
    <div class="status-item">
      <p class="status-label">开赛日期</p>
      <p class="status-value">{season.startDate}</p>
    </div>
    <div class="status-item">
      <p class="status-label">赛季结构</p>
      <p class="status-value">常规赛 6 周 · 季后赛 4 周</p>
    </div>
    <div class="status-item">
      <p class="status-label">每周比赛</p>
      <p class="status-value">周一、周三、周五、周六</p>
    </div>
    <div class="status-item">
      <p class="status-label">比赛时段</p>
      <p class="status-value">{season.startTime}—{season.endTime}</p>
    </div>
  </div>

  <section class="section section--tight">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">固定比赛安排</p>
          <h2>每周四晚，双平台进行</h2>
        </div>
        <a href="/schedule/">查看完整赛程 →</a>
      </div>
      <WeeklyPattern compact />
    </div>
  </section>

  <section class="section home-portals">
    <div class="container portal-grid">
      <a class="portal-card portal-card--standings" href="/standings/">
        <span>争夺段位与荣誉</span>
        <h2>常规赛积分榜</h2>
        <p>查看累计积分、实时名次与段位阶梯。</p>
      </a>
      <a class="portal-card" href="/maps/">
        <span>比赛文件</span>
        <h2>地图下载</h2>
        <p>下载第二届联赛使用的地图。</p>
      </a>
      <a class="portal-card" href="/announcements/">
        <span>赛事动态</span>
        <h2>新闻</h2>
        <p>阅读联赛方案与重要消息。</p>
      </a>
    </div>
  </section>
</BaseLayout>
