---
import PageHero from "../components/PageHero.astro";
import StandingsTable from "../components/StandingsTable.astro";
import TierCrest from "../components/TierCrest.astro";
import { tiers } from "../data/season";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="常规赛积分榜"
  description="第二届 DSL 常规赛个人累计积分榜与荣誉段位。"
>
  <PageHero
    title="常规赛积分榜"
    description="每次参赛与赛事贡献都会累积积分。向更高名次发起冲击，把自己的名字留在赛季荣耀榜上。"
    image="/news/assets/sc-protoss-warrior"
  />

  <section class="section standings-section">
    <div class="container">
      <StandingsTable />
      <p class="privacy-line">
        同分同名次，后续名次按已占人数跳号；跨段位边界的同分选手统一按并列名次确定段位。
        白银及以上的同分选手全部展示，公开人数可超过 40 人。
      </p>
      <p class="privacy-line">
        积分榜展示白银及以上选手的名次、积分与段位；王者和星耀选手额外展示总场数与总胜率。
      </p>
    </div>
  </section>

  <section class="section tier-hall">
    <div class="container">
      <div class="section-heading section-heading--center">
        <div>
          <p class="eyebrow">荣耀阶梯</p>
          <h2>每一次出场，都让段位更进一步</h2>
        </div>
      </div>
      <div class="tier-ladder">
        {
          tiers.map((tier, index) => (
            <article class="tier-emblem" data-tier={tier.name}>
              <span class="tier-position">
                {String(index + 1).padStart(2, "0")}
              </span>
              <TierCrest tier={tier.name} large />
              <div>
                <p>{tier.range}</p>
              </div>
            </article>
          ))
        }
      </div>
      <p class="tier-note">
        原则上黄金及以上（常规赛前 30 名）选手方能获得进入季后赛的资格
      </p>
    </div>
  </section>
</BaseLayout>
