---
import PageHero from "../components/PageHero.astro";
import StandingsTable from "../components/StandingsTable.astro";
import { tiers } from "../data/season";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="常规赛积分榜"
  description="第二届 DSL 常规赛个人累计积分榜与荣誉段位。"
>
  <PageHero
    eyebrow="赛季荣誉中心"
    title="常规赛积分榜"
    description="每次参赛与赛事贡献都会累积积分。向更高名次发起冲击，把自己的名字留在赛季荣誉榜上。"
    image="/news/assets/sc-protoss-warrior.png"
  />

  <section class="section standings-section">
    <div class="container">
      <StandingsTable />
      <p class="privacy-line">
        榜单只展示积分，不展示胜负，让每位玩家都能轻松参与、专注积累。
      </p>
    </div>
  </section>

  <section class="section tier-hall">
    <div class="container">
      <div class="section-heading section-heading--center">
        <div>
          <p class="eyebrow">荣耀阶梯</p>
          <h2>每一次出场，都让段位更进一步</h2>
        </div>
      </div>
      <div class="tier-ladder">
        {
          tiers.map((tier, index) => (
            <article class="tier-emblem" data-tier={tier.name}>
              <span class="tier-position">
                {String(index + 1).padStart(2, "0")}
              </span>
              <span class="tier-symbol" aria-hidden="true">
                {tier.symbol}
              </span>
              <div>
                <h3>{tier.name}</h3>
                <p>{tier.range}</p>
              </div>
            </article>
          ))
        }
      </div>
      <p class="tier-note">黄金及以上选手可进入 KK 战队联赛选拔范围。</p>
    </div>
  </section>
</BaseLayout>
