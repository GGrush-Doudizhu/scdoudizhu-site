---
import PageHero from "../../components/PageHero.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="通知"
  description="第二届 DSL 的赛程调整、地图轮换和规则更新通知。"
>
  <PageHero
    eyebrow="ANNOUNCEMENTS"
    title="所有变化，都有明确记录"
    description="赛程改期、地图轮换、规则修订、队长公布等动态事项将在这里形成带日期的正式通知。"
  />

  <section class="section">
    <div class="container">
      <div class="empty-state panel">
        <span class="empty-orbit" aria-hidden="true"></span>
        <p class="empty-title">暂无正式通知</p>
        <p>
          现阶段不会把筹备备注包装成公告。第一条经过主办方确认的通知发布后，这里将提供永久链接和生效范围。
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
