---
import PageHero from "../../components/PageHero.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

const schemeUrl = encodeURI("/news/第二届DSL斗地主星际联赛方案.html");
---

<BaseLayout title="赛事新闻" description="第二届 DSL 的赛事方案与重要新闻。">
  <PageHero
    eyebrow="赛事动态"
    title="赛事新闻"
    description="了解第二届联赛的重要消息、规则发布与赛事进展。"
    image="/news/assets/sc-terran-fleet.png"
  />

  <section class="section">
    <div class="container news-list">
      <article class="news-card news-card--lead">
        <div class="news-date"><span>2026</span><strong>08.20</strong></div>
        <div>
          <p class="eyebrow">联赛方案</p>
          <h2>第二届 DSL 斗地主星际联赛方案发布</h2>
          <p>
            查看十周赛程、常规赛积分规则、段位体系、双线季后赛与最新奖金安排。
          </p>
          <a class="button button--primary" href={schemeUrl}>阅读完整赛事方案</a
          >
        </div>
      </article>
    </div>
  </section>
</BaseLayout>
