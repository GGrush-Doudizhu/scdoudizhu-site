---
import PageHero from "../components/PageHero.astro";
import Dsl1SponsorTribute from "../components/Dsl1SponsorTribute.astro";
import Dsl2SponsorTribute from "../components/Dsl2SponsorTribute.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="赞助鸣谢"
  description="感谢支持第一届与第二届 DSL 星际斗地主联赛的赞助者。"
>
  <PageHero
    eyebrow="联赛支持者"
    title="赞助鸣谢"
    description="每一场比赛都离不开赞助者的慷慨支持。谨向支持第一届与第二届 DSL 的老板们致以诚挚感谢。"
    image="/news/assets/sc-cosmic-rift"
  />

  <div id="sponsor-thanks" class="sponsor-archive">
    <Dsl2SponsorTribute />
    <Dsl1SponsorTribute />
  </div>
</BaseLayout>
