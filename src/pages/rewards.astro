---
import PageHero from "../components/PageHero.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="奖励与赞助"
  description="第二届 DSL 的常规赛荣誉、季后赛奖金与赞助致谢。"
>
  <PageHero
    eyebrow="荣誉与支持"
    title="奖励与赞助"
    description="常规赛以积分、名次与段位为核心荣誉；季后赛设置现金奖金。"
    image="/news/assets/sc-cosmic-rift.png"
  />

  <section class="sponsor-tribute">
    <div class="container sponsor-tribute-inner">
      <img
        src="/assets/dsl-three-races-suits.png"
        alt=""
        width="140"
        height="140"
      />
      <div>
        <p class="eyebrow">特别致谢</p>
        <h2>感谢以下赞助支持的老板</h2>
        <p>（老板答谢名单会随着众筹的进行更新上来）</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container rewards-grid">
      <article class="reward-card reward-card--honor">
        <p class="eyebrow">常规赛</p>
        <h2>积分 · 段位 · 荣誉</h2>
        <p>
          常规赛不设置现金奖金。持续参赛、提升名次、冲击高段位，让自己的名字留在赛季积分榜上。
        </p>
        <a href="/standings/">前往常规赛积分榜 →</a>
      </article>
      <article class="reward-card">
        <p class="eyebrow">KK 战队联赛</p>
        <p class="reward-amount">1,200 <span>元</span></p>
        <ul class="reward-split">
          <li><span>冠军队</span><strong>600 元</strong></li>
          <li><span>亚军队</span><strong>400 元</strong></li>
          <li><span>季军队</span><strong>200 元</strong></li>
        </ul>
      </article>
      <article class="reward-card">
        <p class="eyebrow">韩服 8R</p>
        <p class="reward-amount">600 <span>元</span></p>
        <ul class="reward-split">
          <li><span>冠军</span><strong>250 元</strong></li>
          <li><span>亚军</span><strong>150 元</strong></li>
          <li><span>季军</span><strong>100 元</strong></li>
          <li><span>第四、第五名</span><strong>各 50 元</strong></li>
        </ul>
      </article>
    </div>
  </section>
</BaseLayout>
