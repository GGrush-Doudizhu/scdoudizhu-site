---
import PageHero from "../components/PageHero.astro";
import PointsTables from "../components/PointsTables.astro";
import { season } from "../data/season";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="比赛规则"
  description="第二届 DSL 的参赛方式、积分规则与常规赛段位说明。"
>
  <PageHero
    eyebrow="参赛与计分"
    title="第二届比赛规则"
    description="常规赛采用个人累计积分制。参加对局、开播参赛或承担赛事工作，都能获得对应积分。"
    image="/news/assets/sc-zerg-swarm"
  />

  <section class="section">
    <div class="container">
      <div class="table-wrap rules-overview-wrap">
        <table class="rules-overview">
          <caption>常规赛基本规则</caption>
          <tbody>
            <tr><th scope="row">开赛日期</th><td>{season.startDate}</td></tr>
            <tr><th scope="row">常规赛</th><td>共 6 周</td></tr>
            <tr><th scope="row">比赛日期</th><td>每周一、三、五、六</td></tr>
            <tr
              ><th scope="row">比赛时段</th><td
                >{season.startTime}—{season.endTime}</td
              ></tr
            >
            <tr
              ><th scope="row">平台安排</th><td
                >KK：周一、周五；韩服：周三、周六</td
              ></tr
            >
            <tr
              ><th scope="row">报名方式</th><td
                >无需提前报名，比赛时段进入比赛房即可参加</td
              ></tr
            >
            <tr
              ><th scope="row">积分方式</th><td
                >参加对局、开播参赛或承担主机、统计工作，均可累计个人积分</td
              ></tr
            >
            <tr
              ><th scope="row">季后赛资格</th><td
                >原则上黄金及以上选手方能获得进入季后赛的资格</td
              ></tr
            >
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">积分规则</p>
          <h2>对局与赛事工作积分</h2>
        </div>
      </div>
      <PointsTables />
      <article class="disconnect-rule" aria-labelledby="disconnect-rule-title">
        <div>
          <p class="eyebrow">异常处理</p>
          <h2 id="disconnect-rule-title">掉线判罚规则</h2>
        </div>
        <ul>
          <li>发生掉线时，掉线方无条件判负。</li>
          <li>掉线者扣除 30 点积分，积分允许扣至负数。</li>
          <li>其余 7 名玩家仍按照本盘正常胜负结算积分。</li>
          <li>
            同一周内累计超过 2 次掉线，即第 3
            次掉线后，本周禁止再次参赛；下周恢复参赛资格。
          </li>
        </ul>
      </article>
      <p class="privacy-line">
        公开积分榜只展示累计积分与段位，不展示个人胜负记录。
      </p>
    </div>
  </section>
</BaseLayout>
