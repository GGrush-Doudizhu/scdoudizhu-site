---
import PageHero from "../components/PageHero.astro";
import PointsTables from "../components/PointsTables.astro";
import WeeklyPattern from "../components/WeeklyPattern.astro";
import { season } from "../data/season";
import disconnectPolicy from "../data/disconnect-policy.json";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="赛程与规则"
  description="第二届 DSL 的十周赛程、参赛方式、积分规则与常规赛段位说明。"
>
  <PageHero
    eyebrow="赛事安排 · 参赛与计分"
    title="第二届赛程与规则"
    description="2026年8月24日开赛，常规赛六周、季后赛四周；常规赛采用个人累计积分制。"
    image="/news/assets/sc-zerg-swarm"
  />

  <section id="schedule" class="section">
    <div class="container">
      <aside class="rules-scheme-callout" aria-labelledby="rules-scheme-title">
        <div>
          <p class="eyebrow">完整赛事文件</p>
          <h2 id="rules-scheme-title">查看第二届 DSL 完整赛事方案</h2>
          <p>
            方案包含完整赛程、积分与段位体系、季后赛安排以及奖金说明，可与本页规则配合查阅。
          </p>
        </div>
        <a class="button button--primary" href="/news/dsl2-league-plan.html"
          >阅读完整赛事方案</a
        >
      </aside>
      <div class="date-banner">
        <span>正式开赛</span>
        <strong>{season.startDate}</strong>
        <p>{season.startTime}—{season.endTime}</p>
      </div>
      <div class="section-heading">
        <div>
          <p class="eyebrow">每周安排</p>
          <h2>周一、周三、周五、周六</h2>
        </div>
      </div>
      <WeeklyPattern />
      <div class="section-heading rules-schedule-heading">
        <div>
          <p class="eyebrow">赛季时间线</p>
          <h2>十周赛季，分为两个阶段</h2>
        </div>
      </div>
      <div class="timeline">
        <article class="timeline-phase timeline-phase--regular">
          <div class="timeline-label">第一周至第六周</div>
          <div>
            <p class="phase-date">{season.regularSeasonRange}</p>
            <h3>常规赛 · 个人累计积分</h3>
            <p>
              常规赛仅有六周。越早参与、越稳定出场，越有机会冲击高段位与季后赛席位。
            </p>
          </div>
        </article>
        <article class="timeline-phase">
          <div class="timeline-label">第七周至第十周</div>
          <div>
            <p class="phase-date">{season.playoffRange}</p>
            <h3>季后赛 · 双线决战</h3>
            <p>KK 四队战队联赛与韩服 8R 个人争霸赛同步进行。</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container">
      <div class="table-wrap rules-overview-wrap">
        <table class="rules-overview">
          <caption>常规赛基本规则</caption>
          <tbody>
            <tr><th scope="row">开赛日期</th><td>{season.startDate}</td></tr>
            <tr><th scope="row">常规赛</th><td>共 6 周</td></tr>
            <tr><th scope="row">比赛日期</th><td>每周一、三、五、六</td></tr>
            <tr
              ><th scope="row">比赛时段</th><td
                >{season.startTime}—{season.endTime}</td
              ></tr
            >
            <tr
              ><th scope="row">平台安排</th><td
                >KK：周一、周五；韩服：周三、周六</td
              ></tr
            >
            <tr
              ><th scope="row">报名方式</th><td
                >无需提前报名，比赛时段进入比赛房即可参加</td
              ></tr
            >
            <tr
              ><th scope="row">积分方式</th><td
                >参加对局或承担房主、主播、统计工作，均可累计个人积分</td
              ></tr
            >
            <tr
              ><th scope="row">季后赛资格</th><td
                >原则上黄金及以上（常规赛前 30 名）选手方能获得进入季后赛的资格</td
              ></tr
            >
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">积分规则</p>
          <h2>对局与赛事工作积分</h2>
        </div>
      </div>
      <PointsTables />
      <p class="privacy-line">
        同一人在同一比赛日兼任房主、主播或赛事数据统计员时，各角色工作分相加，但赛事工作积分合计最高为
        15 分。
      </p>
      <article class="disconnect-rule" aria-labelledby="disconnect-rule-title">
        <div>
          <p class="eyebrow">异常处理</p>
          <h2 id="disconnect-rule-title">掉线判罚规则</h2>
        </div>
        <ul>
          {disconnectPolicy.rules.map((rule) => <li>{rule}</li>)}
          <li>{disconnectPolicy.excludedMatchdays["2026-09-04"]}</li>
        </ul>
      </article>
      <p class="privacy-line">
        公开积分榜展示白银及以上选手；其中仅王者和星耀选手展示总场数与总胜率。
      </p>
    </div>
  </section>
</BaseLayout>
