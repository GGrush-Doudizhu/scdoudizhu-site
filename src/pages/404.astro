---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="页面不存在"
  description="没有找到你访问的 DSL 页面。"
  noindex
>
  <section class="section empty-page">
    <div class="container empty-page-inner">
      <p class="empty-code">404</p>
      <h1>信号离开了航线</h1>
      <p class="lede">这个页面不存在，或者已经移动。</p>
      <div class="hero-actions" style="justify-content: center;">
        <a class="button button--primary" href="/">返回首页</a>
        <a class="button button--secondary" href="/schedule/">查看赛程</a>
      </div>
    </div>
  </section>
</BaseLayout>
