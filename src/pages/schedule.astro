---
import PageHero from "../components/PageHero.astro";
import WeeklyPattern from "../components/WeeklyPattern.astro";
import { season } from "../data/season";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="赛程"
  description="第二届 DSL 的开赛日期、每周安排与十周赛程。"
>
  <PageHero
    eyebrow="第二届赛事安排"
    title="第二届联赛赛程"
    description="2026年8月24日开赛。常规赛六周，季后赛四周；每周一、三、五、六晚进行。"
    image="/news/assets/sc-protoss-carrier.png"
  />

  <section class="section">
    <div class="container">
      <div class="date-banner">
        <span>正式开赛</span>
        <strong>{season.startDate}</strong>
        <p>{season.startTime}—{season.endTime}</p>
      </div>
      <div class="section-heading">
        <div>
          <p class="eyebrow">每周安排</p>
          <h2>周一、周三、周五、周六</h2>
        </div>
      </div>
      <WeeklyPattern />
    </div>
  </section>

  <section class="section section--tint">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">赛季时间线</p>
          <h2>十周赛季，分为两个阶段</h2>
        </div>
      </div>
      <div class="timeline">
        <article class="timeline-phase timeline-phase--regular">
          <div class="timeline-label">第一周至第六周</div>
          <div>
            <p class="phase-date">{season.regularSeasonRange}</p>
            <h3>常规赛 · 个人累计积分</h3>
            <p>
              常规赛仅有六周。越早参与、越稳定出场，越有机会冲击高段位与季后赛席位。
            </p>
          </div>
        </article>
        <article class="timeline-phase">
          <div class="timeline-label">第七周至第十周</div>
          <div>
            <p class="phase-date">{season.playoffRange}</p>
            <h3>季后赛 · 双线决战</h3>
            <p>KK 四队战队联赛与韩服 8R 个人争霸赛同步进行。</p>
          </div>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>
