---
interface Props {
  eyebrow?: string;
  title: string;
  description: string;
  image?: string;
}

const { eyebrow, title, description, image } = Astro.props;
---

<section
  class:list={["page-hero", { "page-hero--image": image }]}
  style={image ? `--page-art: url('${image}')` : undefined}
>
  <div class="container page-hero-inner">
    <div>
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1>{title}</h1>
      <p class="lede">{description}</p>
    </div>
  </div>
</section>
