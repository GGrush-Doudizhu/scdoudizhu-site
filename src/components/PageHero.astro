---
interface Props {
  eyebrow: string;
  title: string;
  description: string;
}

const { eyebrow, title, description } = Astro.props;
---

<section class="page-hero">
  <div class="container page-hero-inner">
    <div>
      <p class="eyebrow">{eyebrow}</p>
      <h1>{title}</h1>
      <p class="lede">{description}</p>
    </div>
    <div class="hero-signal hero-signal--compact" aria-hidden="true">
      <span class="signal-ring signal-ring--one"></span>
      <span class="signal-ring signal-ring--two"></span>
      <span class="signal-core">DSL<span>02</span></span>
    </div>
  </div>
</section>
